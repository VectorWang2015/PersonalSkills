{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book2skill/test-prompts.schema.json",
  "title": "book2skill trigger and execution evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "skill", "version", "source_book", "dataset_role", "holdout_policy", "capability_id", "capability_revision", "bundle", "darwin_compatible", "darwin_compatibility_note", "evaluation", "test_cases"],
  "allOf": [
    {
      "if": {
        "properties": {
          "darwin_compatible": { "const": true }
        },
        "required": ["darwin_compatible"]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "minimum_pass_rate": { "type": "number" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": { "const": "book2skill/test-prompts@1" },
    "suite_id": { "type": "string", "pattern": "^eval\\.[a-z0-9.-]+$" },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source_book": { "type": "string", "minLength": 1 },
    "dataset_role": { "const": "dev_regression" },
    "holdout_policy": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "capability_revision": { "type": "integer", "minimum": 1 },
    "bundle": { "type": "string", "minLength": 1 },
    "darwin_compatible": { "type": "boolean" },
    "darwin_compatibility_note": { "type": "string", "minLength": 1 },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_pass_rate", "release_threshold_rationale", "judge_instruction", "hard_gates"],
      "properties": {
        "minimum_pass_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "release_threshold_rationale": { "type": "string", "minLength": 1 },
        "judge_instruction": { "type": "string", "minLength": 1 },
        "hard_gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt", "expected_behavior", "expected", "rationale", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "enum": ["should_trigger", "should_not_trigger", "route_to_sibling", "edge_case", "adversarial"] },
          "prompt": { "type": "string", "minLength": 1 },
          "expected_behavior": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["activation", "target", "must_do", "must_not_do", "acceptable_variation"],
            "properties": {
              "activation": { "enum": ["invoke", "do_not_invoke", "route_elsewhere", "clarify_then_invoke"] },
              "target": { "type": ["string", "null"] },
              "must_do": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "must_not_do": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "acceptable_variation": { "type": "string" }
            }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
