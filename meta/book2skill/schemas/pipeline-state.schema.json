{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book2skill/pipeline-state.schema.json",
  "title": "book2skill pipeline state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "mode", "status", "started_at", "updated_at", "source_manifest", "target_bundle", "current_stage", "stages", "decisions", "blockers", "next_action", "checkpoints"],
  "properties": {
    "schema": { "const": "book2skill/pipeline-state@1" },
    "run_id": { "type": "string", "pattern": "^run\\.[a-z0-9.-]+$" },
    "mode": { "enum": ["fresh_distillation", "redistillation", "audit_update"] },
    "status": { "enum": ["pending", "in_progress", "blocked", "completed", "cancelled"] },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_manifest": { "type": "string", "minLength": 1 },
    "target_bundle": { "type": "string", "minLength": 1 },
    "current_stage": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "status", "depends_on", "started_at", "completed_at", "artifacts", "checks", "notes"],
        "properties": {
          "stage_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "status": { "enum": ["pending", "in_progress", "blocked", "completed", "skipped"] },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check_id", "status", "evidence"],
              "properties": {
                "check_id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pending", "passed", "failed", "waived"] },
                "evidence": { "type": "string" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "timestamp", "stage_id", "decision", "rationale", "made_by"],
        "properties": {
          "decision_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "stage_id": { "type": "string" },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "made_by": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_id", "description", "owner", "resolution_needed"],
        "properties": {
          "blocker_id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "resolution_needed": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_id", "action", "inputs_needed"],
          "properties": {
            "stage_id": { "type": "string" },
            "action": { "type": "string", "minLength": 1 },
            "inputs_needed": { "type": "array", "items": { "type": "string" } }
          }
        },
        { "type": "null" }
      ]
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "stage_id", "summary", "artifacts"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "stage_id": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
